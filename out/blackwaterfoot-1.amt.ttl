data:stone_S_BUT_001 rdfs:label "Blackwaterfoot 1 (S-BUT-001)" ;
    amt:instanceOf ogham:OghamStone ;
    ogham:hasInscription data:inscription_S_BUT_001_1,
        data:inscription_S_BUT_001_2 ;
    ogham:recordStatus "numbered" .

ogham:AX_editionIsReading a amt:SubsumptionAxiom ;
    amt:subRole ogham:hasEditionReading ;
    amt:superRole ogham:hasReading .

ogham:AX_editionOrHistorical a amt:DisjointAxiom ;
    amt:role1 ogham:hasEditionReading ;
    amt:role2 ogham:hasHistoricalReading .

ogham:AX_historicalIsReading a amt:SubsumptionAxiom ;
    amt:subRole ogham:hasHistoricalReading ;
    amt:superRole ogham:hasReading .

ogham:AX_inscriptionReadByEditor a amt:RoleChainAxiom ;
    amt:antecedent1 ogham:hasInscriptionReading ;
    amt:antecedent2 ogham:attributedTo ;
    amt:consequent ogham:inscriptionReadByEditor ;
    amt:logic amt:ProductLogic .

ogham:AX_readByEditor a amt:RoleChainAxiom ;
    amt:antecedent1 ogham:hasReading ;
    amt:antecedent2 ogham:attributedTo ;
    amt:consequent ogham:readByEditor ;
    amt:logic amt:ProductLogic .

ogham:ConfidenceCertAgreementRule a fw:RuleBasedMethod ;
    rdfs:label "confidence times certainty times agreement rule"@en ;
    fw:formula "c(r) * k(cert) * a(r) / sum(c * k * a)" ;
    fw:implementedBy <https://github.com/LinkedOpenOgham/tei--epidoc-amt/blob/main/py/step_convert.py> ;
    rdfs:comment "Rule v1 with the certainty of the edition as a further factor: weight of a reading among the readings of one stone (or inscription) is c(r) times k(cert) times a(r), divided by the sum of these products. k is the GSAS degree of the level given by the @cert of the edition (low 0.6469, medium 0.8517, high 0.9690), and 1 for an edition without @cert and for every apparatus reading. Four decimals."@en .

ogham:hasInscription a rdf:Property ;
    rdfs:label "has inscription" ;
    rdfs:domain ogham:OghamStone ;
    rdfs:range ogham:Inscription ;
    skos:definition "The monument carries this inscription. Written only for records with several inscriptions." ;
    skos:scopeNote "Carries no weight and is not an amt:Role: nothing is shared out among inscriptions." .

ogham:recordStatus a rdf:Property ;
    rdfs:label "record status" ;
    rdfs:domain ogham:OghamStone ;
    rdfs:range xsd:string ;
    skos:definition "Whether the record is numbered, lost or doubtful, as the series letter of its identifier says." ;
    skos:scopeNote "Says nothing about the reading and does not change any weight: a stone with one reading has weight 1 whatever its status. Proposed term." .

data:evidence_S_BUT_001_i1_EOMEDTE_or_EOMEQE a fw:TextEvidence ;
    fw:sourceString "EOMEDTE or EOMEQE" .

data:evidence_S_BUT_001_i1_EVLEMOE_or_ENEMOE a fw:TextEvidence ;
    fw:sourceString "EVLEMOE or ENEMOE" .

data:evidence_S_BUT_001_i1_H_i_e_OMEQ_i_e a fw:TextEvidence ;
    fw:sourceString "H(i/e)OMEQ(i/e)[~]" .

data:evidence_S_BUT_001_i1_OGHAM_KF a fw:TextEvidence ;
    fw:sourceString "[---]MEQE[---]" .

data:evidence_S_BUT_001_i2_FIS2001 a fw:TextEvidence ;
    fw:sourceString "LUEDBH" .

data:evidence_S_BUT_001_i2_FOR1996 a fw:TextEvidence ;
    fw:sourceString "ADLEUV" .

data:evidence_S_BUT_001_i2_FOR1996_2 a fw:TextEvidence ;
    fw:sourceString "BLUEDLA" .

data:evidence_S_BUT_001_i2_OGHAM_KF a fw:TextEvidence ;
    fw:sourceString "[---]VUEDLA" .

data:reading_S_BUT_001_i1_EOMEDTE_or_EOMEQE rdfs:label "EOMEDTE or EOMEQE" ;
    amt:instanceOf ogham:Reading .

data:reading_S_BUT_001_i1_EVLEMOE_or_ENEMOE rdfs:label "EVLEMOE or ENEMOE" ;
    amt:instanceOf ogham:Reading .

data:reading_S_BUT_001_i1_H_i_e_OMEQ_i_e rdfs:label "H(i/e)OMEQ(i/e)[~]" ;
    amt:instanceOf ogham:Reading .

ogham:inscriptionReadByEditor a amt:Role ;
    rdfs:label "inscription read by editor" ;
    rdfs:domain ogham:Inscription ;
    rdfs:range ogham:Editor ;
    skos:definition "Like readByEditor, for an inscription: derived by axiom ogham:AX_inscriptionReadByEditor from hasInscriptionReading and attributedTo." ;
    skos:scopeNote "Never asserted in the graphs." .

ogham:readByEditor a amt:Role ;
    rdfs:label "read by editor" ;
    rdfs:domain ogham:OghamStone ;
    rdfs:range ogham:Editor ;
    skos:definition "The weight the readings of the editor carry for the stone: derived by axiom ogham:AX_readByEditor from hasReading and attributedTo." ;
    skos:scopeNote "Never asserted in the graphs; it appears only when the engine reasons. If one editor has several readings of a stone, the engine keeps the largest weight." .

data:agent_FIS2001 a prov:Agent ;
    rdfs:label "Fis 2001" ;
    amt:instanceOf ogham:Editor .

data:reading_S_BUT_001_i1_OGHAM_KF rdfs:label "[---]MEQE[---]" ;
    amt:instanceOf ogham:Reading ;
    prov:wasAttributedTo data:agent_OGHAM_KF .

data:reading_S_BUT_001_i2_FIS2001 rdfs:label "LUEDBH" ;
    amt:instanceOf ogham:Reading ;
    prov:wasAttributedTo data:agent_FIS2001 .

data:reading_S_BUT_001_i2_FOR1996 rdfs:label "ADLEUV" ;
    amt:instanceOf ogham:Reading ;
    prov:wasAttributedTo data:agent_FOR1996 .

data:reading_S_BUT_001_i2_FOR1996_2 rdfs:label "BLUEDLA" ;
    amt:instanceOf ogham:Reading ;
    prov:wasAttributedTo data:agent_FOR1996 .

data:reading_S_BUT_001_i2_OGHAM_KF rdfs:label "[---]VUEDLA" ;
    amt:instanceOf ogham:Reading ;
    prov:wasAttributedTo data:agent_OGHAM_KF .

ogham:hasEditionReading a amt:Role ;
    rdfs:label "has edition reading" ;
    rdfs:domain ogham:OghamStone ;
    rdfs:range ogham:Reading ;
    skos:definition "The stone is read this way in the current edition of the OG(H)AM team. A kind of hasReading (axiom ogham:AX_editionIsReading)." ;
    skos:scopeNote "Carries the same weight as the hasReading statement for the same reading." .

ogham:hasHistoricalReading a amt:Role ;
    rdfs:label "has historical reading" ;
    rdfs:domain ogham:OghamStone ;
    rdfs:range ogham:Reading ;
    skos:definition "The stone is read this way by an earlier editor, as the apparatus records it. A kind of hasReading (axiom ogham:AX_historicalIsReading)." ;
    skos:scopeNote "Carries the same weight as the hasReading statement for the same reading." .

ogham:hasReading a amt:Role ;
    rdfs:label "has reading" ;
    rdfs:domain ogham:OghamStone ;
    rdfs:range ogham:Reading ;
    skos:definition "The stone is read this way by an editor. Each statement carries the weight of that reading among the readings of the stone." ;
    skos:scopeNote "Does not say that the reading is correct, and does not say which editor is more reliable: the weight is the normalised product of reading confidence and tradition agreement (rule v1). It has no inverse, because a share among alternatives is directional. In a record with several inscriptions the subject is the inscription and the role is ogham:hasInscriptionReading." .

data:agent_FOR1996 a prov:Agent ;
    rdfs:label "Forsyth 1996" ;
    amt:instanceOf ogham:Editor .

data:agent_OGHAM_KF a prov:Agent ;
    rdfs:label "OG(H)AM edition (KF)" ;
    amt:instanceOf ogham:Editor .

data:inscription_S_BUT_001_1 rdfs:label "Blackwaterfoot 1, inscription 1 (S-BUT-001)" ;
    amt:instanceOf ogham:Inscription .

data:inscription_S_BUT_001_2 rdfs:label "Blackwaterfoot 1, inscription 2 (S-BUT-001)" ;
    amt:instanceOf ogham:Inscription .

ogham:Inscription a amt:Concept ;
    rdfs:label "Inscription" ;
    rdfs:comment "One inscription on a monument whose record describes several (Blackwaterfoot 1 has two with a reading). It exists only for those records: for a record with one inscription, the stone stands for it." ;
    skos:scopeNote "Not a text: the text is the reading. Readings of different inscriptions are not alternatives of each other, so their weights are computed within the inscription." .

ogham:Editor a amt:Concept ;
    rdfs:label "Editor" ;
    rdfs:comment "A person or edition team that read the inscription the way a reading says: Rhys 1899, Macalister 1945, the OG(H)AM edition (KF). Known from the source id of the reading; a reading without a source has none." ;
    skos:scopeNote "Not the author of the weight: the weight is computed by the rule, not given by the editor." .

ogham:OghamStone a amt:Concept ;
    rdfs:label "Ogham stone" ;
    rdfs:comment "A monument that carries an ogham inscription, as one OG(H)AM EpiDoc file describes it. Identified by its CIIC number, or by the name of its record where it has none." .

ogham:attributedTo a amt:Role ;
    rdfs:label "attributed to" ;
    rdfs:domain ogham:Reading ;
    rdfs:range ogham:Editor ;
    skos:definition "The reading is the editor's reading. Written with weight 1 for every reading whose source the file names." ;
    skos:scopeNote "The weight 1 says that the attribution is as the file gives it, not that the reading is correct. It is the second link of the editor chains. The same fact is also written as prov:wasAttributedTo." .

ogham:ConfidenceAgreementRule a fw:RuleBasedMethod ;
    rdfs:label "confidence times agreement rule"@en ;
    fw:formula "c(r) * a(r) / sum(c * a)" ;
    fw:implementedBy <https://github.com/LinkedOpenOgham/tei--epidoc-amt/blob/main/py/step_convert.py> ;
    rdfs:comment "Weight of a reading among the readings of one stone: the reading confidence c(r) (from the doubt markup of the reading) times the tradition agreement a(r) (the share of readings that cluster with it), divided by the sum of these products over all readings of the stone. Four decimals."@en .

ogham:hasInscriptionReading a amt:Role ;
    rdfs:label "has inscription reading" ;
    rdfs:domain ogham:Inscription ;
    rdfs:range ogham:Reading ;
    skos:definition "The inscription is read this way. Used instead of hasReading where a record has several inscriptions; the weight is the share of the reading among the readings of that inscription." ;
    skos:scopeNote "Same weight rule as hasReading. No sub-roles: the inscriptions of Blackwaterfoot 1 carry the axioms only through the editor chain." .

ogham:Reading a amt:Concept ;
    rdfs:label "Reading" ;
    rdfs:comment "One transliteration of the inscription: either the current edition of the OG(H)AM team or a historical reading from the apparatus of the EpiDoc file." .
