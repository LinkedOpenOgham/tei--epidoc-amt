@prefix amt: <http://academic-meta-tool.xyz/vocab#> .
@prefix data: <http://data.ogham.link/amt/> .
@prefix fw: <http://w3id.org/fw_ontology/> .
@prefix ogham: <http://ontology.ogham.link/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:stmt_81_OGHAM_NW amt:weight 1.0000 ;
    fw:derivedFrom data:evidence_81_OGHAM_NW ;
    fw:hasMethod ogham:ConfidenceCertAgreementRule ;
    fw:hasType fw:Vagueness ;
    rdf:object data:reading_81_OGHAM_NW ;
    rdf:predicate ogham:hasReading ;
    rdf:subject data:stone_81 .

ogham:ConfidenceAgreementRule a fw:RuleBasedMethod ;
    rdfs:label "confidence times agreement rule"@en ;
    fw:formula "c(r) * a(r) / sum(c * a)" ;
    fw:implementedBy <https://github.com/LinkedOpenOgham/tei--epidoc-amt/blob/main/py/step_convert.py> ;
    rdfs:comment "Weight of a reading among the readings of one stone: the reading confidence c(r) (from the doubt markup of the reading) times the tradition agreement a(r) (the share of readings that cluster with it), divided by the sum of these products over all readings of the stone. Four decimals."@en .

ogham:hasInscription a rdf:Property ;
    rdfs:label "has inscription" ;
    rdfs:domain ogham:OghamStone ;
    rdfs:range ogham:Inscription ;
    skos:definition "The monument carries this inscription. Written only for records with several inscriptions." ;
    skos:scopeNote "Carries no weight and is not an amt:Role: nothing is shared out among inscriptions." .

ogham:recordStatus a rdf:Property ;
    rdfs:label "record status" ;
    rdfs:domain ogham:OghamStone ;
    rdfs:range xsd:string ;
    skos:definition "Whether the record is numbered, lost or doubtful, as the series letter of its identifier says." ;
    skos:scopeNote "Says nothing about the reading and does not change any weight: a stone with one reading has weight 1 whatever its status. Proposed term." .

data:agent_OGHAM_NW a prov:Agent ;
    rdfs:label "OG(H)AM edition (NW)" .

data:evidence_81_OGHAM_NW a fw:TextEvidence ;
    fw:sourceString "CASSITTAS MAQI MUCOI CALLITI" .

data:reading_81_OGHAM_NW rdfs:label "CASSITTAS MAQI MUCOI CALLITI" ;
    amt:instanceOf ogham:Reading ;
    prov:wasAttributedTo data:agent_OGHAM_NW .

data:stone_81 rdfs:label "An Garrán | Garranes (CIIC 81)" ;
    amt:instanceOf ogham:OghamStone ;
    ogham:recordStatus "numbered" .

ogham:ConfidenceCertAgreementRule a fw:RuleBasedMethod ;
    rdfs:label "confidence times certainty times agreement rule"@en ;
    fw:formula "c(r) * k(cert) * a(r) / sum(c * k * a)" ;
    fw:implementedBy <https://github.com/LinkedOpenOgham/tei--epidoc-amt/blob/main/py/step_convert.py> ;
    rdfs:comment "Rule v1 with the certainty of the edition as a further factor: weight of a reading among the readings of one stone (or inscription) is c(r) times k(cert) times a(r), divided by the sum of these products. k is the GSAS degree of the level given by the @cert of the edition (low 0.6469, medium 0.8517, high 0.9690), and 1 for an edition without @cert and for every apparatus reading. Four decimals."@en .

ogham:Inscription a amt:Concept ;
    rdfs:label "Inscription" ;
    rdfs:comment "One inscription on a monument whose record describes several (Blackwaterfoot 1 has two with a reading). It exists only for those records: for a record with one inscription, the stone stands for it." ;
    skos:scopeNote "Not a text: the text is the reading. Readings of different inscriptions are not alternatives of each other, so their weights are computed within the inscription." .

ogham:hasReading a amt:Role ;
    rdfs:label "has reading" ;
    rdfs:range ogham:Reading ;
    skos:definition "The stone, or its inscription where the record has several, is read this way by an editor. Each statement carries the weight of that reading among the readings of the same stone or inscription." ;
    skos:scopeNote "Does not say that the reading is correct, and does not say which editor is more reliable: the weight is the normalised product of reading confidence and tradition agreement (rule v1). It has no inverse, because a share among alternatives is directional. The subject is an ogham:OghamStone, or an ogham:Inscription in a record with several inscriptions; a formal domain is left out for that reason." .

ogham:Reading a amt:Concept ;
    rdfs:label "Reading" ;
    rdfs:comment "One transliteration of the inscription: either the current edition of the OG(H)AM team or a historical reading from the apparatus of the EpiDoc file." .

ogham:OghamStone a amt:Concept ;
    rdfs:label "Ogham stone" ;
    rdfs:comment "A monument that carries an ogham inscription, as one OG(H)AM EpiDoc file describes it. Identified by its CIIC number, or by the name of its record where it has none." .
